<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/glass_bg_light" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/glass_bg_light" />
            <stroke android:width="1px" android:color="@color/m3_primary" />
            <corners android:radius="24dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/glass_bg_medium" />
            <corners android:radius="24dp" />
        </shape>
    </item>
</selector>