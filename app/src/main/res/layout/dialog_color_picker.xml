<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="16dp"
    android:paddingEnd="16dp"
    android:paddingTop="8dp"
    android:paddingBottom="8dp"
    android:gravity="center_vertical">

    <!-- Left Column: Color Wheel -->
    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_vertical"
        android:padding="2dp">

        <com.skydoves.colorpickerview.ColorPickerView
            android:id="@+id/colorPickerView"
            android:layout_width="190dp"
            android:layout_height="190dp"
            android:layout_gravity="center"
            app:selector="@drawable/colorpickerview_wheel" />
    </FrameLayout>

    <!-- Right Column: Previews, Hex, Brightness & Alpha Sliders -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="16dp"
        android:layout_gravity="center_vertical"
        android:orientation="vertical">

        <!-- Previews & Hex Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="38dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- Current Color Tile -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Current"
                    android:textSize="10sp"
                    android:textColor="@color/m3_on_surface_variant" />

                <com.skydoves.colorpickerview.AlphaTileView
                    android:id="@+id/colorPreviewCurrent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- New Color Tile -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New"
                    android:textSize="10sp"
                    android:textColor="@color/m3_on_surface_variant" />

                <com.skydoves.colorpickerview.AlphaTileView
                    android:id="@+id/colorPreviewNew"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <!-- Hex Code Input -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1.5"
                android:layout_marginStart="10dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hex Code"
                    android:textSize="10sp"
                    android:textColor="@color/m3_on_surface_variant" />

                <EditText
                    android:id="@+id/hexValue"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginTop="2dp"
                    android:gravity="center"
                    android:inputType="textCapCharacters|textNoSuggestions"
                    android:maxLength="9"
                    android:fontFamily="monospace"
                    android:textSize="12sp"
                    android:textColor="@color/m3_on_surface"
                    android:background="@drawable/bg_frosted_glass_button"
                    android:padding="2dp" />
            </LinearLayout>
        </LinearLayout>

        <!-- Brightness Slider -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Brightness"
            android:textSize="10sp"
            android:textColor="@color/m3_on_surface_variant"
            android:layout_marginTop="10dp" />

        <com.skydoves.colorpickerview.sliders.BrightnessSlideBar
            android:id="@+id/brightnessSlideBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            app:selector_BrightnessSlider="@drawable/colorpickerview_wheel" />

        <!-- Opacity Slider (toggleable) -->
        <LinearLayout
            android:id="@+id/alphaSlideBarContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Opacity"
                android:textSize="10sp"
                android:textColor="@color/m3_on_surface_variant"
                android:layout_marginTop="8dp" />

            <com.skydoves.colorpickerview.sliders.AlphaSlideBar
                android:id="@+id/alphaSlideBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                app:selector_AlphaSlideBar="@drawable/colorpickerview_wheel" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>
