<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="true"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="?attr/dialogPreferredPadding"
        android:paddingEnd="?attr/dialogPreferredPadding"
        android:paddingTop="4dp"
        android:paddingBottom="8dp">

        <!-- Current / New color preview -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:orientation="horizontal"
            android:layout_marginTop="8dp">

            <View
                android:id="@+id/colorPreviewCurrent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/m3_surface" />

            <View
                android:id="@+id/colorPreviewNew"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:background="@color/m3_surface" />
        </LinearLayout>

        <!-- Rainbow box -->
        <paulscode.android.mupen64plusae.ui.RainbowPickerView
            android:id="@+id/rainbowBox"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:layout_marginTop="16dp"
            android:nextFocusDown="@+id/hueSlider"
            android:nextFocusUp="@+id/hueSlider" />

        <!-- Hue slider -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="Hue"
            android:textColor="@color/m3_on_surface_variant"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:labelFor="@+id/hueSlider" />

        <paulscode.android.mupen64plusae.ui.PickerSliderView
            android:id="@+id/hueSlider"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:nextFocusDown="@+id/saturationSlider"
            android:nextFocusUp="@+id/rainbowBox" />

        <!-- Saturation slider -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Saturation"
            android:textColor="@color/m3_on_surface_variant"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:labelFor="@+id/saturationSlider" />

        <paulscode.android.mupen64plusae.ui.PickerSliderView
            android:id="@+id/saturationSlider"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:nextFocusDown="@+id/valueSlider"
            android:nextFocusUp="@+id/hueSlider" />

        <!-- Brightness slider -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Brightness"
            android:textColor="@color/m3_on_surface_variant"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:labelFor="@+id/valueSlider" />

        <paulscode.android.mupen64plusae.ui.PickerSliderView
            android:id="@+id/valueSlider"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:nextFocusDown="@+id/opacitySlider"
            android:nextFocusUp="@+id/saturationSlider" />

        <!-- Opacity slider -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Opacity"
            android:textColor="@color/m3_on_surface_variant"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:labelFor="@+id/opacitySlider" />

        <paulscode.android.mupen64plusae.ui.PickerSliderView
            android:id="@+id/opacitySlider"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:nextFocusDown="@+id/contrastSlider"
            android:nextFocusUp="@+id/valueSlider" />

        <!-- Contrast slider -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Contrast"
            android:textColor="@color/m3_on_surface_variant"
            android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
            android:labelFor="@+id/contrastSlider" />

        <paulscode.android.mupen64plusae.ui.PickerSliderView
            android:id="@+id/contrastSlider"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="4dp"
            android:nextFocusUp="@+id/opacitySlider" />

        <!-- Hex value -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hex"
                android:textColor="@color/m3_on_surface_variant"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:labelFor="@+id/hexValue" />

            <EditText
                android:id="@+id/hexValue"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:inputType="textCapCharacters"
                android:maxLength="9"
                android:singleLine="true"
                android:textColor="@color/m3_on_surface"
                android:textColorHint="@color/m3_on_surface_variant"
                android:hint="#RRGGBBAA"
                android:background="@android:color/transparent" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
